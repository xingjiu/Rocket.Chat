{
	"name": "Rocket.Chat Gitpod",
	"build": {
        "context": "..",
        "dockerfile": "./Dockerfile"
    },
	"runArgs": [
		"--add-host=host.docker.internal:host-gateway", 
		"-v", "/var/run/docker.sock:/var/run/docker-host.sock"
	  ],
	"forwardPorts": [3000],
	"customizations": {
		"vscode": {
			"extensions": [
				"esbenp.prettier-vscode"
			]
		}
	}
}
